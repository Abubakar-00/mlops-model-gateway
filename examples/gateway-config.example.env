# Example gateway configuration (mounted from a ConfigMap). All values are placeholders.

# ==================== Service endpoints ====================
MODEL_REGISTRY_ENDPOINT=http://model-registry.ml-pipelines.svc.cluster.local:8080

# ==================== Environment → namespace ====================
STAGING_NAMESPACE=ml-staging
PRODUCTION_NAMESPACE=ml-production
KUBEFLOW_NAMESPACE=ml-pipelines

# ==================== task_type → serving config ====================
# gpu_memory is a per-predictor GPU memory budget (MiB) used by the GPU queue scheduler.
TASK_TYPE_CONFIGS='
{
  "object-detection": {
    "runtime": "triton-onnx",
    "model_format": "onnx",
    "service_account": "kserve-sa",
    "gpu_memory": 5000
  },
  "ocr": {
    "runtime": "vlm-ocr-runtime",
    "model_format": "vlm",
    "service_account": "kserve-sa",
    "gpu_memory": 12000
  },
  "speech-to-text": {
    "runtime": "vllm-whisper",
    "model_format": "whisper",
    "service_account": "kserve-sa",
    "gpu_memory": 20000
  }
}
'
